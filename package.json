{
  "name": "xiamimate-lab",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "计算机专业课交互仿真实验室 —— 引擎与内核",
  "scripts": {
    "test": "tsx tests/run-all.ts",
    "test:phase0": "tsx tests/phase0-convergence.test.ts",
    "test:sweep": "tsx tests/parameter-axis.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "demo:cache": "tsx src/reference/cache.ts",
    "demo:sched": "tsx src/reference/scheduler.ts",
    "demo:tcp": "tsx src/reference/tcp.ts",
    "ai:fill": "tsx scripts/ai-fill.ts",
    "ai:bench": "tsx scripts/ai-bench.ts",
    "ai:l2": "tsx scripts/ai-l2.ts",
    "test:l2": "tsx tests/compose-l2.test.ts",
    "web": "vite --config web/vite.config.ts web",
    "web:build": "vite build --config web/vite.config.ts web",
    "web:single": "VITE_NO3D=1 npm run web:build && node scripts/bundle-single.mjs",
    "web:lab": "VITE_BASE=/cslab/ vite --config web/vite.config.ts web",
    "web:build:lab": "VITE_BASE=/cslab/ vite build --config web/vite.config.ts web",
    "ai:serve": "tsx server/index.ts",
    "gateway": "node scripts/local-gateway.mjs",
    "sync:tokens": "node scripts/sync-brand-tokens.mjs",
    "smoke": "node scripts/web-smoke.mjs",
    "smoke:platform": "node scripts/platform-smoke.mjs",
    "contrast": "node scripts/theme-contrast.mjs --all",
    "smoke:guide": "node scripts/guide-coverage-smoke.mjs",
    "smoke:zero": "node scripts/step-zero-smoke.mjs",
    "smoke:knobs": "node scripts/knob-sweep-smoke.mjs"
  },
  "devDependencies": {
    "@types/matter-js": "^0.20.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.0.5",
    "playwright": "^1.62.1",
    "tsx": "^4.23.0",
    "typescript": "^5.9.0",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "matter-js": "^0.20.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  }
}
